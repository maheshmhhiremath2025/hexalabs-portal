{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSmallEC2Only",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": [
            "t2.micro", "t2.small", "t2.medium",
            "t3.micro", "t3.small", "t3.medium",
            "t3a.micro", "t3a.small", "t3a.medium"
          ]
        }
      }
    },
    {
      "Sid": "DenyLargeEC2",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "ForAllValues:StringNotEquals": {
          "ec2:InstanceType": [
            "t2.micro", "t2.small", "t2.medium",
            "t3.micro", "t3.small", "t3.medium",
            "t3a.micro", "t3a.small", "t3a.medium"
          ]
        }
      }
    },
    {
      "Sid": "DenyGPUInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringLike": { "ec2:InstanceType": ["p*", "g*", "inf*", "trn*", "dl*", "x*", "m6i*", "c6*", "r5*", "r6*", "z1*", "u-*"] }
      }
    },
    {
      "Sid": "AllowOnlyMicroRDS",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:RestoreDBInstanceFromS3"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringNotEquals": {
          "rds:DatabaseClass": [
            "db.t2.micro",
            "db.t3.micro",
            "db.t4g.micro"
          ]
        }
      }
    },
    {
      "Sid": "DenyExpensiveStorage",
      "Effect": "Deny",
      "Action": "ec2:CreateVolume",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "ec2:VolumeType": ["io1", "io2"] }
      }
    },
    {
      "Sid": "LimitVolumeSize",
      "Effect": "Deny",
      "Action": "ec2:CreateVolume",
      "Resource": "*",
      "Condition": {
        "NumericGreaterThan": { "ec2:VolumeSize": "50" }
      }
    },
    {
      "Sid": "DenyExpensiveServices",
      "Effect": "Deny",
      "Action": [
        "redshift:*",
        "es:*",
        "elasticache:*",
        "emr:*",
        "sagemaker:*",
        "eks:*",
        "ecs:CreateCluster",
        "fsx:*",
        "transfer:*",
        "kafka:*",
        "neptune-db:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LockToRegion",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": { "aws:RequestedRegion": "ap-south-1" }
      }
    }
  ]
}
